<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<div class="container">
  <h1><%= event ? 'Edit event' : 'New event' %></h1>
  <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

  <form method="POST" action="<%= event && event._id ? '/events/' + event._id + '?_method=PUT' : '/events' %>">
    <div class="mb-3">
      <label class="form-label">Title</label>
      <input type="text" name="title" class="form-control" required value="<%= event ? event.title : '' %>">
    </div>
    <div class="mb-3">
      <label class="form-label">Description</label>
      <textarea name="description" class="form-control" rows="3"><%= event ? event.description : '' %></textarea>
    </div>
    <div class="row">
      <div class="col-md-6 mb-3">
        <label class="form-label">Category</label>
        <select name="category" class="form-select" required>
          <% categories.forEach(c => { %>
            <option value="<%= c %>" <%= event && event.category === c ? 'selected' : '' %>><%= c %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-6 mb-3">
        <label class="form-label">Capacity</label>
        <input type="number" min="1" name="capacity" class="form-control" required value="<%= event ? event.capacity : '' %>">
      </div>
    </div>
    <div class="mb-3">
      <label class="form-label">Tags</label>
      <div>
        <% allTags.forEach(t => {
          const checked = event && event.tags && event.tags.includes(t);
        %>
          <div class="form-check form-check-inline">
            <input class="form-check-input" type="checkbox" name="tags" value="<%= t %>" <%= checked ? 'checked' : '' %>>
            <label class="form-check-label"><%= t %></label>
          </div>
        <% }) %>
      </div>
    </div>
    <div class="row">
      <div class="col-md-6 mb-3">
        <label class="form-label">Start date</label>
        <input type="datetime-local" name="startDate" class="form-control" required
          value="<%= event && event.startDate ? new Date(event.startDate).toISOString().slice(0,16) : '' %>">
      </div>
      <div class="col-md-6 mb-3">
        <label class="form-label">End date</label>
        <input type="datetime-local" name="endDate" class="form-control" required
          value="<%= event && event.endDate ? new Date(event.endDate).toISOString().slice(0,16) : '' %>">
      </div>
    </div>
    <h6 class="mt-3">Location (embedded object)</h6>
    <div class="row">
      <div class="col-md-4 mb-3">
        <label class="form-label">Building</label>
        <input type="text" name="building" class="form-control" value="<%= event && event.location ? event.location.building : '' %>">
      </div>
      <div class="col-md-4 mb-3">
        <label class="form-label">Room</label>
        <input type="text" name="room" class="form-control" value="<%= event && event.location ? event.location.room : '' %>">
      </div>
      <div class="col-md-4 mb-3">
        <label class="form-label">Campus</label>
        <input type="text" name="campus" class="form-control" value="<%= event && event.location ? event.location.campus : '' %>">
      </div>
    </div>
    <% if (!event) { %>
    <div class="mb-3">
      <label class="form-label">Organizer</label>
      <select name="organizerId" class="form-select" required>
        <% allUsers.forEach(u => { %>
          <option value="<%= u._id %>"><%= u.firstName %> <%= u.lastName %></option>
        <% }) %>
      </select>
    </div>
    <% } %>
    <button class="btn btn-primary"><%= event ? 'Save changes' : 'Create event' %></button>
    <a href="/events" class="btn btn-link">Cancel</a>
  </form>
</div>
<%- include('../partials/foot') %>
